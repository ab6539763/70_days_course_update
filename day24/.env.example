# Day 24 · 星火智服 Web Chat 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- LLM ----------
# 留空则自动 mock 模式（课堂默认，无需 API Key）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 强制 mock（CI / 验收脚本）
SPARKTECH_MOCK=1

# ---------- 数据库 ----------
# SQLite 文件路径（默认 day24/data/chat_history.db）
# SQLITE_PATH=./data/chat_history.db

# ---------- CORS ----------
# 前端静态服务地址，逗号分隔
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ---------- 服务 ----------
# BACKEND_PORT=8000
# FRONTEND_PORT=8080
