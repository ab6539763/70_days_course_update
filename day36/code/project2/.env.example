# Project 2 · 企业知识库问答 — 环境变量示例
# 复制为 .env 后按需修改

# mock=1 时无需 API Key 即可完整演示
SPARKTECH_MOCK=1

# Live 模式（可选）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# SQLite 路径（默认 data/kb_qa.db）
# SQLITE_PATH=./data/kb_qa.db

# CORS 允许的前端源
# CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

BACKEND_PORT=8000
FRONTEND_PORT=8080
